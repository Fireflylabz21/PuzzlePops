<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Financial Command Center | Mobile Wealth System (INR)</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            200: '#a7f3d0',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            900: '#064e3b',
                        },
                        appbg: '#f8fafc',
                        cardbg: '#ffffff',
                    },
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    
    <!-- Canvas Confetti CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        :root {
            --sat: env(safe-area-inset-top, 0px);
            --sab: env(safe-area-inset-bottom, 0px);
        }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior-y: none;
        }

        /* Clean Light Glass Surfaces */
        .glass-header {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.9);
        }

        .glass-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 2px 10px -2px rgba(15, 23, 42, 0.05), 0 1px 3px 0 rgba(15, 23, 42, 0.03);
        }

        .glass-panel {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
        }

        .mobile-nav-container {
            padding-bottom: max(0.5rem, var(--sab));
        }

        .app-content-container {
            padding-bottom: calc(5.2rem + var(--sab));
        }

        /* Active Navigation Tab Styling */
        .desktop-nav-btn.active {
            background: #ecfdf5;
            border-color: #10b981;
            color: #047857;
            font-weight: 700;
        }

        .mobile-nav-btn.active {
            color: #059669;
        }
        .mobile-nav-btn.active i {
            transform: scale(1.12);
        }
        .mobile-nav-btn.active .nav-indicator {
            opacity: 1;
            transform: scaleX(1);
        }

        /* Touch input sizing to prevent iOS auto-zoom */
        input[type=number], input[type=text], select {
            font-size: 16px !important;
        }

        /* Range slider styling */
        input[type=range] {
            accent-color: #059669;
        }

        /* Animations */
        .tab-content-panel {
            animation: fadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(3px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-white select-none">

    <!-- Top App Bar Optimized for Mobile -->
    <header class="sticky top-0 z-40 glass-header">
        <div class="max-w-md md:max-w-4xl mx-auto px-4 h-14 sm:h-16 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white font-black text-base shadow-sm shrink-0">
                    <i class="fa-solid fa-indian-rupee-sign"></i>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <h1 class="font-extrabold text-sm sm:text-base text-slate-900 tracking-tight leading-tight">DhanCommand</h1>
                        <span class="px-1.5 py-0.5 rounded bg-emerald-100 border border-emerald-300 text-[9px] font-bold text-emerald-800">INR</span>
                    </div>
                    <p class="text-[10px] text-slate-500 tracking-tight">Personal Cash Flow & Compounding System</p>
                </div>
            </div>

            <!-- Health Score Header Badge & Reset -->
            <div class="flex items-center gap-2">
                <div id="header-health-badge" class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-[11px] font-bold flex items-center gap-1.5 shadow-xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Health: <strong id="header-health-score" class="font-black text-emerald-950">84</strong><span class="text-slate-500 font-normal">/100</span></span>
                </div>
                
                <button onclick="loadSampleData()" class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-xs transition flex items-center gap-1 active:scale-95" title="Reset Demo Data">
                    <i class="fa-solid fa-rotate-right text-xs"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Desktop Navigation Pill Bar (Hidden on Mobile) -->
    <nav class="bg-white border-b border-slate-200 sticky top-14 z-30 hidden md:block">
        <div class="max-w-4xl mx-auto px-4">
            <div class="flex space-x-1.5 overflow-x-auto py-2">
                <button onclick="switchTab('dashboard')" id="tab-btn-dashboard" class="desktop-nav-btn active px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-transparent text-slate-600 hover:text-slate-900 transition flex items-center gap-2">
                    <i class="fa-solid fa-gauge-high"></i> Executive View
                </button>
                <button onclick="switchTab('cashflow')" id="tab-btn-cashflow" class="desktop-nav-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-transparent text-slate-600 hover:text-slate-900 transition flex items-center gap-2">
                    <i class="fa-solid fa-scale-balanced"></i> 50/30/20 Budget
                </button>
                <button onclick="switchTab('debt')" id="tab-btn-debt" class="desktop-nav-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-transparent text-slate-600 hover:text-slate-900 transition flex items-center gap-2">
                    <i class="fa-solid fa-fire text-amber-600"></i> Debt Avalanche
                </button>
                <button onclick="switchTab('emergency')" id="tab-btn-emergency" class="desktop-nav-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-transparent text-slate-600 hover:text-slate-900 transition flex items-center gap-2">
                    <i class="fa-solid fa-shield-heart text-cyan-600"></i> Emergency Cushion
                </button>
                <button onclick="switchTab('subscriptions')" id="tab-btn-subscriptions" class="desktop-nav-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-transparent text-slate-600 hover:text-slate-900 transition flex items-center gap-2">
                    <i class="fa-solid fa-scissors text-rose-600"></i> Leak Auditor
                </button>
                <button onclick="switchTab('wealth')" id="tab-btn-wealth" class="desktop-nav-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-transparent text-slate-600 hover:text-slate-900 transition flex items-center gap-2">
                    <i class="fa-solid fa-arrow-trend-up text-emerald-600"></i> Wealth SIP Engine
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Mobile Frame Container -->
    <main class="flex-1 max-w-md md:max-w-4xl w-full mx-auto px-3.5 py-3 app-content-container">

        <!-- TAB 1: EXECUTIVE DASHBOARD (MOBILE PORTRAIT FIRST) -->
        <section id="tab-dashboard" class="tab-content-panel space-y-3.5">
            <!-- Health Status Card -->
            <div class="glass-card rounded-2xl p-4 bg-gradient-to-br from-white via-slate-50 to-emerald-50/40 border border-slate-200 relative overflow-hidden">
                <div class="flex items-center justify-between gap-3">
                    <div class="space-y-1">
                        <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase tracking-wider">
                            <i class="fa-solid fa-bolt"></i> Health Score
                        </div>
                        <h2 class="text-base font-black text-slate-900 tracking-tight">Financial Health Grade</h2>
                        <p class="text-slate-600 text-xs leading-snug">
                            Savings rate, debt payoff velocity, emergency buffer & leakage audit.
                        </p>
                    </div>

                    <!-- Health Gauge Dial -->
                    <div class="relative w-18 h-18 sm:w-20 sm:h-20 shrink-0 flex items-center justify-center">
                        <svg class="w-18 h-18 sm:w-20 sm:h-20 transform -rotate-90" viewBox="0 0 36 36">
                            <path class="text-slate-200" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                            <path id="dash-health-circle" class="text-emerald-500 transition-all duration-1000 ease-out" stroke-dasharray="84, 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                            <span id="dash-health-num" class="text-xl font-black text-slate-900 leading-none">84</span>
                            <span id="dash-health-status" class="text-[9px] uppercase font-extrabold text-emerald-700 mt-0.5">Strong</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Key Financial Metrics 2x2 Grid (Mobile Portrait) -->
            <div class="grid grid-cols-2 gap-2.5">
                <!-- Monthly Net Income -->
                <div class="glass-card p-3 rounded-xl flex flex-col justify-between cursor-pointer hover:border-slate-300 transition" onclick="switchTab('cashflow')">
                    <div class="flex items-center justify-between text-slate-500">
                        <span class="text-[10px] font-bold uppercase tracking-wider">Take-Home</span>
                        <div class="w-6 h-6 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div id="dash-val-income" class="text-base font-black text-slate-900">₹85,000</div>
                        <span class="text-[10px] text-slate-500">Per Month</span>
                    </div>
                </div>

                <!-- 20% Auto-Savings -->
                <div class="glass-card p-3 rounded-xl flex flex-col justify-between cursor-pointer hover:border-slate-300 transition" onclick="switchTab('cashflow')">
                    <div class="flex items-center justify-between text-slate-500">
                        <span class="text-[10px] font-bold uppercase tracking-wider">Auto-Save 20%</span>
                        <div class="w-6 h-6 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center text-xs">
                            <i class="fa-solid fa-piggy-bank"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div id="dash-val-savings" class="text-base font-black text-teal-700">₹17,000</div>
                        <span class="text-[10px] text-slate-500">Pay Yourself First</span>
                    </div>
                </div>

                <!-- High-Interest Debt -->
                <div class="glass-card p-3 rounded-xl flex flex-col justify-between cursor-pointer hover:border-slate-300 transition" onclick="switchTab('debt')">
                    <div class="flex items-center justify-between text-slate-500">
                        <span class="text-[10px] font-bold uppercase tracking-wider">High Debt</span>
                        <div class="w-6 h-6 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-xs">
                            <i class="fa-solid fa-fire"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div id="dash-val-debt" class="text-base font-black text-amber-600">₹1,90,000</div>
                        <span id="dash-val-debt-months" class="text-[10px] text-slate-500 block truncate">14 mo payoff</span>
                    </div>
                </div>

                <!-- Recurring Subscriptions Leak -->
                <div class="glass-card p-3 rounded-xl flex flex-col justify-between cursor-pointer hover:border-slate-300 transition" onclick="switchTab('subscriptions')">
                    <div class="flex items-center justify-between text-slate-500">
                        <span class="text-[10px] font-bold uppercase tracking-wider">Annual Leaks</span>
                        <div class="w-6 h-6 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center text-xs">
                            <i class="fa-solid fa-scissors"></i>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div id="dash-val-leak" class="text-base font-black text-rose-600">₹27,780</div>
                        <span id="dash-val-leak-count" class="text-[10px] text-slate-500 block truncate">4 active subs</span>
                    </div>
                </div>
            </div>

            <!-- 50/30/20 Doughnut Allocation Matrix -->
            <div class="glass-card rounded-2xl p-4 border border-slate-200 space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-teal-600 text-xs"></i>
                        <h3 class="font-bold text-xs text-slate-900">50 / 30 / 20 Allocation Matrix</h3>
                    </div>
                    <button onclick="switchTab('cashflow')" class="text-[11px] font-bold text-emerald-700 hover:underline">Adjust</button>
                </div>

                <div class="h-44 relative flex items-center justify-center">
                    <canvas id="dashCashFlowChart"></canvas>
                </div>

                <div class="grid grid-cols-3 text-center gap-1.5 pt-1 text-xs border-t border-slate-100">
                    <div class="bg-slate-50 p-2 rounded-xl border border-slate-200/80">
                        <span class="block text-[10px] font-semibold text-slate-500">Needs (50%)</span>
                        <span id="dash-needs-val" class="font-extrabold text-blue-700">₹42,500</span>
                    </div>
                    <div class="bg-slate-50 p-2 rounded-xl border border-slate-200/80">
                        <span class="block text-[10px] font-semibold text-slate-500">Wants (30%)</span>
                        <span id="dash-wants-val" class="font-extrabold text-purple-700">₹25,500</span>
                    </div>
                    <div class="bg-slate-50 p-2 rounded-xl border border-slate-200/80">
                        <span class="block text-[10px] font-semibold text-slate-500">Wealth (20%)</span>
                        <span id="dash-savings-val" class="font-extrabold text-emerald-700">₹17,000</span>
                    </div>
                </div>
            </div>

            <!-- Priority Action Steps -->
            <div class="glass-card rounded-2xl p-4 border border-slate-200 space-y-2.5">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-emerald-600 text-xs"></i>
                        <h3 class="font-bold text-xs text-slate-900">Prioritized Action Items</h3>
                    </div>
                    <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">Auto Prioritized</span>
                </div>

                <div class="space-y-2" id="dash-checklist-container">
                    <!-- Dynamic Checklist items injected via JS -->
                </div>
            </div>
        </section>

        <!-- TAB 2: CASH FLOW & 50/30/20 BUDGET PLANNER -->
        <section id="tab-cashflow" class="tab-content-panel space-y-3.5 hidden">
            <div class="glass-card p-4 rounded-2xl space-y-4">
                <div>
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase tracking-wider mb-1">
                        <i class="fa-solid fa-sliders"></i> Foundation Step
                    </div>
                    <h2 class="text-sm sm:text-base font-black text-slate-900 flex items-center gap-2">
                        Pay-Yourself-First 50/30/20 Calculator
                    </h2>
                    <p class="text-xs text-slate-500">
                        Divert 20% to savings & debt reduction on salary day before lifestyle expenses erode cash.
                    </p>
                </div>

                <!-- Monthly Take-Home Salary Controller -->
                <div class="glass-panel p-3.5 rounded-xl border border-slate-200 space-y-2.5">
                    <div class="flex items-center justify-between gap-1">
                        <label for="cashflow-income-input" class="text-xs font-bold text-slate-700">Monthly Net In-Hand Salary</label>
                        <div class="flex items-center gap-1">
                            <button onclick="setIncomePreset(45000)" class="px-2 py-0.5 rounded bg-white hover:bg-slate-100 text-[10px] text-slate-700 font-semibold border border-slate-200">₹45k</button>
                            <button onclick="setIncomePreset(85000)" class="px-2 py-0.5 rounded bg-white hover:bg-slate-100 text-[10px] text-slate-700 font-semibold border border-slate-200">₹85k</button>
                            <button onclick="setIncomePreset(150000)" class="px-2 py-0.5 rounded bg-white hover:bg-slate-100 text-[10px] text-slate-700 font-semibold border border-slate-200">₹1.5L</button>
                            <button onclick="setIncomePreset(250000)" class="px-2 py-0.5 rounded bg-white hover:bg-slate-100 text-[10px] text-slate-700 font-semibold border border-slate-200">₹2.5L</button>
                        </div>
                    </div>

                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500 font-black text-base">₹</span>
                        <input type="number" id="cashflow-income-input" oninput="updateCashflowCalculations()" class="w-full pl-8 pr-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-900 font-black text-base focus:outline-none focus:border-emerald-600 transition" value="85000" step="5000">
                    </div>

                    <input type="range" min="20000" max="400000" step="5000" value="85000" id="cashflow-income-range" oninput="syncIncomeFromRange(this.value)" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer">
                    
                    <div class="flex justify-between text-[10px] text-slate-500 font-medium">
                        <span>₹20k/mo</span>
                        <span>₹2L/mo</span>
                        <span>₹4L/mo</span>
                    </div>
                </div>

                <!-- 3 Budget Buckets -->
                <div class="space-y-3">
                    <!-- Needs Bucket -->
                    <div class="glass-panel p-3.5 rounded-xl border border-blue-200 space-y-2 relative overflow-hidden bg-blue-50/20">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black uppercase text-blue-700 flex items-center gap-1.5">
                                <i class="fa-solid fa-house-chimney"></i> Needs (50%)
                            </span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-bold">Non-Negotiable</span>
                        </div>
                        <div id="cashflow-needs-target" class="text-xl font-black text-slate-900">₹42,500</div>
                        <p class="text-[11px] text-slate-600">Rent/Home Loan EMI, groceries, electricity, school fees & fuel.</p>

                        <div class="space-y-1 pt-2 border-t border-blue-100 text-xs">
                            <div class="flex justify-between text-slate-600">
                                <span>Rent / Home EMI</span>
                                <span class="font-bold text-slate-900" id="cf-house-val">₹25,500</span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>Groceries & Provisions</span>
                                <span class="font-bold text-slate-900" id="cf-food-val">₹11,500</span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>Utilities & Transit</span>
                                <span class="font-bold text-slate-900" id="cf-trans-val">₹5,500</span>
                            </div>
                        </div>
                    </div>

                    <!-- Wants Bucket -->
                    <div class="glass-panel p-3.5 rounded-xl border border-purple-200 space-y-2 relative overflow-hidden bg-purple-50/20">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black uppercase text-purple-700 flex items-center gap-1.5">
                                <i class="fa-solid fa-utensils"></i> Wants (30%)
                            </span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 font-bold">Lifestyle</span>
                        </div>
                        <div id="cashflow-wants-target" class="text-xl font-black text-slate-900">₹25,500</div>
                        <p class="text-[11px] text-slate-600">Dining out, Swiggy/Zomato, weekend outings, shopping & OTT.</p>

                        <div class="space-y-1 pt-2 border-t border-purple-100 text-xs">
                            <div class="flex justify-between text-slate-600">
                                <span>Dining & Food Delivery</span>
                                <span class="font-bold text-slate-900" id="cf-dining-val">₹10,200</span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>Shopping & Fashion</span>
                                <span class="font-bold text-slate-900" id="cf-shop-val">₹12,750</span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>OTT & Leisure</span>
                                <span class="font-bold text-slate-900" id="cf-subs-val">₹2,550</span>
                            </div>
                        </div>
                    </div>

                    <!-- Wealth / Savings Bucket -->
                    <div class="glass-panel p-3.5 rounded-xl border border-emerald-200 space-y-2 relative overflow-hidden bg-emerald-50/30">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black uppercase text-emerald-800 flex items-center gap-1.5">
                                <i class="fa-solid fa-vault"></i> Wealth (20%)
                            </span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold">Future Freedom</span>
                        </div>
                        <div id="cashflow-wealth-target" class="text-xl font-black text-slate-900">₹17,000</div>
                        <p class="text-[11px] text-slate-600">High-interest debt crusher, emergency liquid buffer & Mutual Fund SIP.</p>

                        <div class="space-y-1 pt-2 border-t border-emerald-100 text-xs">
                            <div class="flex justify-between text-slate-600">
                                <span>Debt Crusher Extra</span>
                                <span class="font-bold text-slate-900" id="cf-debt-accel">₹6,800</span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>Emergency Liquid Fund</span>
                                <span class="font-bold text-slate-900" id="cf-emerg-accel">₹3,400</span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>Index & Equity SIP</span>
                                <span class="font-bold text-slate-900" id="cf-invest-accel">₹6,800</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
