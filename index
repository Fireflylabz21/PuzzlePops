        function simulateDebtPayoff(debts, booster) {
            let workingDebts = debts.map(d => ({ ...d, currentBal: d.balance }));
            let totalInterest = 0;
            let month = 0;
            let balanceHistory = [workingDebts.reduce((s, d) => s + d.currentBal, 0)];
            let individualMonths = {};

            while (workingDebts.some(d => d.currentBal > 0) && month < 180) {
                month++;
                let extraCash = booster;

                // 1. Accrue interest & pay minimums
                workingDebts.forEach(d => {
                    if (d.currentBal > 0) {
                        const monthlyInterest = (d.currentBal * (d.apr / 100)) / 12;
                        totalInterest += monthlyInterest;
                        d.currentBal += monthlyInterest;

                        let minP = Math.min(d.currentBal, d.minPayment);
                        d.currentBal -= minP;
                    }
                });

                // 2. Extra cash to top priority debt
                for (let d of workingDebts) {
                    if (d.currentBal > 0) {
                        let payment = Math.min(d.currentBal, extraCash);
                        d.currentBal -= payment;
                        extraCash -= payment;

                        if (d.currentBal <= 0 && !individualMonths[d.id]) {
                            individualMonths[d.id] = month;
                        }
                        if (extraCash <= 0) break;
                    }
                }

                const currentSum = workingDebts.reduce((s, d) => s + Math.max(0, d.currentBal), 0);
                balanceHistory.push(Math.round(currentSum));
            }

            return { totalMonths: month, totalInterest, balanceHistory, individualMonths };
        }

