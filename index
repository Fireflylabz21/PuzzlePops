        function calculateHealthScore() {
            let score = 40;

            // 1. Savings Ratio (+20 max)
            const autoSavingsRatio = 0.20;
            score += Math.round(autoSavingsRatio * 100);

            // 2. Emergency Coverage (+25 max)
            const monthlyEssentials = appState.monthlyIncome * 0.50;
            const monthsCovered = appState.emergency.currentSaved / (monthlyEssentials || 1);
            if (monthsCovered >= 6) score += 25;
            else if (monthsCovered >= 3) score += 15;
            else score += Math.round((monthsCovered / 3) * 10);

            // 3. High Interest Debt
            const totalDebt = appState.debts.reduce((sum, d) => sum + d.balance, 0);
            if (totalDebt === 0) score += 15;
            else if (totalDebt < appState.monthlyIncome * 1.5) score += 5;
            else score -= 10;

            // 4. Subscriptions Leaks (+10 max)
            const activeSubCost = appState.subscriptions.filter(s => s.active).reduce((sum, s) => sum + s.cost, 0);
            if (activeSubCost < 1500) score += 10;
            else if (activeSubCost < 3000) score += 5;

            return Math.min(100, Math.max(10, Math.round(score)));
        }

