            const apy = parseFloat(document.getElementById('emerg-hysa-apy').value) || 7.1;

            const monthlyEssentials = appState.monthlyIncome * 0.50;
            const targetTotal = monthlyEssentials * targetMonths;
            const gap = Math.max(0, targetTotal - saved);
            const progressPercent = Math.min(100, (saved / (targetTotal || 1)) * 100).toFixed(1);

            document.getElementById('emerg-months-label').innerText = `${targetMonths} Months`;
            document.getElementById('emerg-monthly-essentials').innerText = `${formatINR(monthlyEssentials)} / mo essentials`;
            document.getElementById('emerg-progress-percent').innerText = `${progressPercent}%`;
            document.getElementById('emerg-progress-bar').style.width = `${progressPercent}%`;

            document.getElementById('emerg-saved-display').innerText = formatINR(saved);
            document.getElementById('emerg-target-display').innerText = formatINR(targetTotal);
            document.getElementById('emerg-gap-val').innerText = formatINR(gap);

            const monthsToGoal = monthlyContrib > 0 ? (gap / monthlyContrib).toFixed(0) : "N/A";
            document.getElementById('emerg-time-val').innerText = `${monthsToGoal} Mo`;

            const annualInterest = saved * (apy / 100);
            document.getElementById('emerg-hysa-yield').innerText = `${formatINR(annualInterest)}/yr`;

            if (parseFloat(progressPercent) >= 100) {
                triggerConfetti();
            }
        }

        function updateEmergencyCalculations() {
            appState.emergency.currentSaved = parseFloat(document.getElementById('emerg-current-saved').value) || 0;
            appState.emergency.monthlyContrib = parseFloat(document.getElementById('emerg-monthly-contrib').value) || 0;
            appState.emergency.targetMonths = parseInt(document.getElementById('emerg-months-range').value) || 6;
            appState.emergency.hysaApy = parseFloat(document.getElementById('emerg-hysa-apy').value) || 7.1;
            renderEmergency();
            renderHealthScore();
        }

        function renderSubscriptions() {
            const container = document.getElementById('sub-list-container');
            if (!container) return;
            container.innerHTML = '';

            const activeSubs = appState.subscriptions.filter(s => s.active);
            const monthlyTotal = activeSubs.reduce((sum, s) => sum + s.cost, 0);
            const annualTotal = monthlyTotal * 12;

            document.getElementById('sub-monthly-total').innerText = `${formatINR(monthlyTotal)}/mo`;
            document.getElementById('sub-annual-total').innerText = `${formatINR(annualTotal)}/yr`;

            // 10-Yr Compound Lost Opportunity at 12% Nifty CAGR
            const compoundLoss = annualTotal * (((Math.pow(1 + 0.12, 10) - 1) / 0.12));
            document.getElementById('sub-compound-loss').innerText = formatINR(compoundLoss, true);

            appState.subscriptions.forEach(sub => {
                const card = document.createElement('div');
                card.className = `p-3 rounded-xl border transition flex flex-col justify-between space-y-2 ${sub.active ? 'bg-slate-50 border-slate-200' : 'bg-rose-50/40 border-rose-200 opacity-60'}`;
                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${sub.active ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">${sub.category}</span>
                            <h4 class="font-bold text-slate-900 text-xs mt-1">${sub.name}</h4>
                        </div>
                        <div class="text-right">
                            <span class="font-black text-slate-900 text-xs">${formatINR(sub.cost)}</span>
                            <span class="text-[10px] text-slate-500 block">/month</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-1.5 border-t border-slate-200/80 text-xs">
                        <span class="text-[10px] text-slate-500">${formatINR(sub.cost * 12)}/yr drain</span>
                        <div class="flex items-center gap-1.5">
                            <button onclick="toggleSub(${sub.id})" class="px-2 py-0.5 rounded-lg text-[11px] font-bold transition ${sub.active ? 'bg-rose-100 text-rose-700 hover:bg-rose-200' : 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200'}">
                                ${sub.active ? 'Cancel' : 'Restore'}
                            </button>
                            <button onclick="deleteSub(${sub.id})" class="text-slate-400 hover:text-rose-600 p-1"><i class="fa-solid fa-trash text-[11px]"></i></button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function toggleSub(id) {
            const sub = appState.subscriptions.find(s => s.id === id);
            if (sub) {
                sub.active = !sub.active;
                renderSubscriptions();
                renderDashboard();
                renderHealthScore();
                showToast(sub.active ? `Restored ${sub.name}` : `Cancelled ${sub.name}! Saved ${formatINR(sub.cost * 12)}/yr`);
            }
        }

        function deleteSub(id) {
            appState.subscriptions = appState.subscriptions.filter(s => s.id !== id);
            renderSubscriptions();
            renderDashboard();
            renderHealthScore();
            showToast("Subscription deleted");
        }

        function renderWealth() {
            const initial = parseFloat(document.getElementById('wealth-initial').value) || 0;
            const monthly = parseFloat(document.getElementById('wealth-monthly').value) || 0;
            const years = parseInt(document.getElementById('wealth-years-range').value) || 20;
            let rate = parseFloat(document.getElementById('wealth-rate').value) || 12.0;
            const adjustInflation = document.getElementById('wealth-inflation-toggle').checked;

            document.getElementById('wealth-years-val').innerText = `${years} Years`;

            if (adjustInflation) rate -= 6.0; // Subtract Indian CPI inflation

            const monthlyRate = rate / 100 / 12;
            const totalMonths = years * 12;

            let balance = initial;
            let totalContributed = initial;
            let history = [initial];
            let contributedHistory = [initial];

            for (let m = 1; m <= totalMonths; m++) {
                balance = balance * (1 + monthlyRate) + monthly;
                totalContributed += monthly;
                if (m % 12 === 0) {
                    history.push(Math.round(balance));
                    contributedHistory.push(Math.round(totalContributed));
                }
            }

            const totalInterest = Math.max(0, balance - totalContributed);

            document.getElementById('wealth-total-future').innerText = formatINR(balance, true);
            document.getElementById('wealth-total-contributed').innerText = formatINR(totalContributed, true);
            document.getElementById('wealth-total-interest').innerText = formatINR(totalInterest, true);

            renderWealthChart(years, history, contributedHistory);
        }

        function updateWealthCalculations() {
            renderWealth();
        }

        function renderWealthChart(years, history, contributedHistory) {
            const ctx = document.getElementById('wealthGrowthChart');
            if (!ctx) return;

            const labels = Array.from({ length: years + 1 }, (_, i) => `Y${i}`);

            if (charts.wealth) charts.wealth.destroy();

            charts.wealth = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Total Corpus (₹)',
                            data: history,
                            borderColor: '#059669',
                            backgroundColor: 'rgba(5, 150, 105, 0.08)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 0
                        },
                        {
                            label: 'Principal Invested (₹)',
                            data: contributedHistory,
                            borderColor: '#94a3b8',
                            borderDash: [3, 3],
                            fill: false,
                            tension: 0.1,
                            borderWidth: 1.5,
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: { color: '#64748b', font: { size: 9 }, boxWidth: 10 }
                        },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: ${formatINR(ctx.raw)}`
                            }
                        }
                    },
                    scales: {
                        x: { 
                            grid: { color: 'rgba(0,0,0,0.05)' }, 
                            ticks: { color: '#64748b', font: { size: 9 }, maxTicksLimit: 6 } 
                        },
                        y: { 
                            grid: { color: 'rgba(0,0,0,0.05)' }, 
                            ticks: { 
                                color: '#64748b', 
                                font: { size: 9 },
                                callback: val => formatINR(val, true)
                            } 
                        }
                    }
                }
            });
        }

        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.remove('hidden');
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.add('hidden');
        }

        function saveNewDebt() {
            const name = document.getElementById('modal-debt-name').value.trim();
            const balance = parseFloat(document.getElementById('modal-debt-balance').value);
            const apr = parseFloat(document.getElementById('modal-debt-apr').value);
            const min = parseFloat(document.getElementById('modal-debt-min').value);

            if (name && !isNaN(balance) && !isNaN(apr) && !isNaN(min)) {
                appState.debts.push({ id: Date.now(), name, balance, apr, minPayment: min });
                closeModal('add-debt-modal');
                
                document.getElementById('modal-debt-name').value = '';
                document.getElementById('modal-debt-balance').value = '';
                document.getElementById('modal-debt-apr').value = '';
                document.getElementById('modal-debt-min').value = '';

                renderDebts();
                renderDashboard();
                renderHealthScore();
                showToast("New debt item registered!");
            } else {
                showToast("Please fill all loan fields.");
            }
        }

        function deleteDebt(id) {
            appState.debts = appState.debts.filter(d => d.id !== id);
            renderDebts();
            renderDashboard();
            renderHealthScore();
            showToast("Debt item removed.");
        }

        function saveNewSub() {
            const name = document.getElementById('modal-sub-name').value.trim();
            const cost = parseFloat(document.getElementById('modal-sub-cost').value);
            const category = document.getElementById('modal-sub-category').value;

            if (name && !isNaN(cost)) {
                appState.subscriptions.push({ id: Date.now(), name, cost, category, active: true });
                closeModal('add-sub-modal');

                document.getElementById('modal-sub-name').value = '';
                document.getElementById('modal-sub-cost').value = '';

                renderSubscriptions();
                renderDashboard();
                renderHealthScore();
                showToast("Subscription leak tracked!");
            } else {
                showToast("Please enter service name and monthly cost.");
            }
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-notification');
            const msgEl = document.getElementById('toast-message');
            if (!toast || !msgEl) return;

            msgEl.innerText = msg;
            toast.classList.remove('-translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-20', 'opacity-0');
            }, 2500);
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 50,
                    spread: 60,
                    origin: { y: 0.65 }
                });
            }
        }
    </script>
</body>
</html>
